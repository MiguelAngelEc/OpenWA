# Railway/OpenWA upgrade reference — no secrets
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Single-instance WhatsApp engine
ENGINE_TYPE=whatsapp-web.js
SESSION_DATA_PATH=./data/sessions
AUTO_START_SESSIONS=true

# Required for @lid -> real phone resolution
RESOLVE_LID_TO_PHONE=true

# Keep the current n8n text filter working during the OpenWA upgrade.
# Remove after n8n is changed from type='chat' to type='text'.
LEGACY_WEBHOOK_TEXT_TYPE_CHAT=true

# Local persistent data on Railway volume mounted at /app/data
DATABASE_TYPE=sqlite
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# Modern media variable names
MEDIA_DOWNLOAD_ENABLED=true
# MEDIA_DOWNLOAD_MAX_BYTES=52428800
# INBOUND_MEDIA_CONCURRENCY=4

# Optional bundled dashboard
SERVE_DASHBOARD=true
